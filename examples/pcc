#!/bin/sh
# Runs the self-hosted compiler (build/bin/pcc-self) with the given
# arguments, building it first if needed. Without arguments, in a project
# directory, it builds the project described by pcc.json.
#
#   PCC_BUILD_DIR   the CMake build directory (default: <repository>/build)
set -e
here=$(cd "$(dirname "$0")" && pwd)
build=${PCC_BUILD_DIR:-$here/../build}
if [ ! -f "$build/build.ninja" ] && [ ! -f "$build/Makefile" ]; then
  echo "examples/pcc: no build directory at $build; configure the compiler first" >&2
  echo "  cmake -S . -B build -G Ninja && cmake --build build" >&2
  exit 1
fi
# (rebuilds pcc-self only when the compiler's sources changed)
cmake --build "$build" --target pcc-self >/dev/null || {
  echo "examples/pcc: building the self-hosted compiler failed; run" >&2
  echo "  cmake --build $build --target pcc-self" >&2
  exit 1
}
exec "$build/bin/pcc-self" "$@"
