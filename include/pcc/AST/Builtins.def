//===- Builtins.def - Predeclared procedures and functions --------*- C++ -*-===//
//
// Required procedures/functions of ISO 7185 6.6.5-6.6.6 that are implemented.
// Names listed in PLAN.md 4.5 but not here yet are reported as
// "not supported yet" by Sema (see FutureBuiltins in Sema.cpp).
//
//   BUILTIN_PROC(ID, NAME)   used as a statement
//   BUILTIN_FUNC(ID, NAME)   used in an expression
//
//===----------------------------------------------------------------------===//

#ifndef BUILTIN_PROC
#define BUILTIN_PROC(ID, NAME)
#endif
#ifndef BUILTIN_FUNC
#define BUILTIN_FUNC(ID, NAME)
#endif

// I/O on the standard files (M2/M4). Files proper: M10.
BUILTIN_PROC(Write,   "write")
BUILTIN_PROC(Writeln, "writeln")
BUILTIN_PROC(Read,    "read")
BUILTIN_PROC(Readln,  "readln")

// Files (M10). eof/eoln default to `input`, page to `output`.
BUILTIN_PROC(Reset,   "reset")
BUILTIN_PROC(Rewrite, "rewrite")
BUILTIN_PROC(Get,     "get")
BUILTIN_PROC(Put,     "put")
BUILTIN_PROC(Page,    "page")
BUILTIN_FUNC(Eof,     "eof")
BUILTIN_FUNC(Eoln,    "eoln")

// Transfer between packed and unpacked arrays (M10).
BUILTIN_PROC(Pack,    "pack")
BUILTIN_PROC(Unpack,  "unpack")

// Dynamic allocation (M9).
BUILTIN_PROC(New,     "new")
BUILTIN_PROC(Dispose, "dispose")

// Arithmetic / ordinal functions (M4); abs/sqr also take reals (M7).
BUILTIN_FUNC(Abs,  "abs")
BUILTIN_FUNC(Sqr,  "sqr")
BUILTIN_FUNC(Odd,  "odd")
BUILTIN_FUNC(Ord,  "ord")
BUILTIN_FUNC(Chr,  "chr")
BUILTIN_FUNC(Succ, "succ")
BUILTIN_FUNC(Pred, "pred")

// Real functions (M7). Integer arguments are converted to real.
BUILTIN_FUNC(Sin,    "sin")
BUILTIN_FUNC(Cos,    "cos")
BUILTIN_FUNC(Exp,    "exp")
BUILTIN_FUNC(Ln,     "ln")
BUILTIN_FUNC(Sqrt,   "sqrt")
BUILTIN_FUNC(Arctan, "arctan")
BUILTIN_FUNC(Trunc,  "trunc")
BUILTIN_FUNC(Round,  "round")

#undef BUILTIN_FUNC
#undef BUILTIN_PROC
