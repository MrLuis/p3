//===- Builtins.def - Predeclared procedures and functions --------*- C++ -*-===//
//
// Required procedures/functions of ISO 7185 6.6.5-6.6.6 that are implemented.
// Names listed in PLAN.md 4.5 but not here yet are reported as
// "not supported yet" by Sema (see FutureBuiltins in Sema.cpp).
//
//   BUILTIN_PROC(ID, NAME)   used as a statement
//   BUILTIN_FUNC(ID, NAME)   used in an expression
//
//===----------------------------------------------------------------------===//

#ifndef BUILTIN_PROC
#define BUILTIN_PROC(ID, NAME)
#endif
#ifndef BUILTIN_FUNC
#define BUILTIN_FUNC(ID, NAME)
#endif

// I/O on the standard files (M2/M4). Files proper: M10.
BUILTIN_PROC(Write,   "write")
BUILTIN_PROC(Writeln, "writeln")
BUILTIN_PROC(Read,    "read")
BUILTIN_PROC(Readln,  "readln")

// Files (M10). eof/eoln default to `input`, page to `output`.
BUILTIN_PROC(Reset,   "reset")
BUILTIN_PROC(Rewrite, "rewrite")
BUILTIN_PROC(Get,     "get")
BUILTIN_PROC(Put,     "put")
BUILTIN_PROC(Page,    "page")
BUILTIN_FUNC(Eof,     "eof")
BUILTIN_FUNC(Eoln,    "eoln")

// Transfer between packed and unpacked arrays (M10).
BUILTIN_PROC(Pack,    "pack")
BUILTIN_PROC(Unpack,  "unpack")

// Turbo/Free Pascal (M12, --mode=tp only).
BUILTIN_PROC(Break,    "break")
BUILTIN_PROC(Continue, "continue")
BUILTIN_PROC(Exit,     "exit")
BUILTIN_PROC(Inc,      "inc")
BUILTIN_PROC(Dec,      "dec")
BUILTIN_PROC(Delete,   "delete")
BUILTIN_PROC(Insert,   "insert")
BUILTIN_PROC(SetLength, "setlength")
BUILTIN_FUNC(Length,   "length")
BUILTIN_FUNC(Copy,     "copy")
BUILTIN_FUNC(Slice,    "slice")
BUILTIN_FUNC(Pos,      "pos")
BUILTIN_FUNC(Concat,   "concat")
BUILTIN_FUNC(UpCase,   "upcase")

// Turbo/FPC file routines (tp and objfpc; AssignFile and CloseFile only in
// objfpc): naming, closing, untyped files' blocks, random access.
BUILTIN_PROC(Assign,     "assign")
BUILTIN_PROC(AssignFile, "assignfile")
BUILTIN_PROC(Close,      "close")
BUILTIN_PROC(CloseFile,  "closefile")
BUILTIN_PROC(Flush,      "flush") // a text file's buffered output
BUILTIN_PROC(BlockRead,  "blockread")
BUILTIN_PROC(BlockWrite, "blockwrite")
BUILTIN_PROC(Seek,       "seek")
BUILTIN_FUNC(FilePos,    "filepos")
BUILTIN_FUNC(FileSize,   "filesize")
BUILTIN_FUNC(GetFileHandle, "getfilehandle") // the OS handle (THandle)

// Turbo/FPC memory, type and program built-ins (S1).
BUILTIN_PROC(GetMem,     "getmem")
BUILTIN_PROC(FreeMem,    "freemem")
BUILTIN_PROC(ReallocMem, "reallocmem")
BUILTIN_PROC(FillChar,   "fillchar")
BUILTIN_PROC(Move,       "move")
BUILTIN_PROC(Halt,       "halt")
BUILTIN_FUNC(SizeOf,     "sizeof")
BUILTIN_FUNC(Low,        "low")
BUILTIN_FUNC(High,       "high")
BUILTIN_FUNC(Assigned,   "assigned")
BUILTIN_FUNC(ParamCount, "paramcount")
BUILTIN_FUNC(ParamStr,   "paramstr")
BUILTIN_FUNC(ExceptAddr, "exceptaddr") // objfpc: the handled exception's address

// Dynamic allocation (M9).
BUILTIN_PROC(New,     "new")
BUILTIN_PROC(Dispose, "dispose")

// Arithmetic / ordinal functions (M4); abs/sqr also take reals (M7).
BUILTIN_FUNC(Abs,  "abs")
BUILTIN_FUNC(Sqr,  "sqr")
BUILTIN_FUNC(Odd,  "odd")
BUILTIN_FUNC(Ord,  "ord")
BUILTIN_FUNC(Chr,  "chr")
BUILTIN_FUNC(Succ, "succ")
BUILTIN_FUNC(Pred, "pred")

// Real functions (M7). Integer arguments are converted to real.
BUILTIN_FUNC(Sin,    "sin")
BUILTIN_FUNC(Cos,    "cos")
BUILTIN_FUNC(Exp,    "exp")
BUILTIN_FUNC(Ln,     "ln")
BUILTIN_FUNC(Sqrt,   "sqrt")
BUILTIN_FUNC(Arctan, "arctan")
BUILTIN_FUNC(Trunc,  "trunc")
BUILTIN_FUNC(Round,  "round")

// Overflow-checked arithmetic (objfpc): the tuple (a op b, no overflow),
// whatever {$Q} says, instead of an exception.
BUILTIN_FUNC(AddChecked, "addchecked")
BUILTIN_FUNC(SubChecked, "subchecked")
BUILTIN_FUNC(MulChecked, "mulchecked")

// Tasks (objfpc): Wait(t) waits for a task anywhere (await: in async
// routines); WhenAll(tasks) / WhenAny(tasks) are tasks of their own.
BUILTIN_FUNC(Wait,    "wait")
BUILTIN_FUNC(WhenAll, "whenall")
BUILTIN_FUNC(WhenAny, "whenany")

#undef BUILTIN_FUNC
#undef BUILTIN_PROC
