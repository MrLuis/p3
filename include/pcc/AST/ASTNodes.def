//===- ASTNodes.def - Every AST node class ------------------------*- C++ -*-===//
//
// X-macro list of concrete AST node classes. Adding a node here makes the
// visitors (ASTVisitor.h) fail to compile until every visitor handles it.
//
//   EXPR(Name)  -> class NameExpr  : Expr, kind Expr::EK_Name
//   STMT(Name)  -> class NameStmt  : Stmt, kind Stmt::SK_Name
//
//===----------------------------------------------------------------------===//

#ifndef EXPR
#define EXPR(CLASS)
#endif
#ifndef STMT
#define STMT(CLASS)
#endif

// Expressions
EXPR(IntegerLiteral)  // 42
EXPR(RealLiteral)     // 3.14, 1e10                            (M7)
EXPR(StringLiteral)   // 'abc', 'c'
EXPR(NameRef)         // x, maxint, true, red, f (call w/o args)
EXPR(Paren)           // ( e )
EXPR(Unary)           // -e, +e, not e
EXPR(Binary)          // a + b, a div b, a < b, a and b, ...
EXPR(Call)            // abs(x), f(1, 2)
EXPR(Formatted)       // e:width[:precision] in write/writeln
EXPR(Index)           // a[i]                                  (M8)
EXPR(Field)           // r.f                                   (M8)
EXPR(Nil)             // nil                                   (M9)
EXPR(Deref)           // p^                                    (M9)
EXPR(SetCtor)         // [1, 3..5, c]                          (M9)
EXPR(AddrOf)          // @x                                    (M12, TP)
EXPR(Aggregate)       // (1, 2) / (x: 1; y: 2) typed constants (S1, TP)

// Statements
STMT(Empty)
STMT(Compound)
STMT(ProcCall)
STMT(Assign)
STMT(If)
STMT(While)
STMT(Repeat)
STMT(For)
STMT(Case)
STMT(With)            // with r1, r2 do s                      (M8)
STMT(Labeled)         // 10: s                                 (M10)
STMT(Goto)            // goto 10                               (M10)

#undef STMT
#undef EXPR
