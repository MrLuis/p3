//===- ASTNodes.def - Every AST node class ------------------------*- C++ -*-===//
//
// X-macro list of concrete AST node classes. Adding a node here makes the
// visitors (ASTVisitor.h) fail to compile until every visitor handles it.
//
//   EXPR(Name)  -> class NameExpr  : Expr, kind Expr::EK_Name
//   STMT(Name)  -> class NameStmt  : Stmt, kind Stmt::SK_Name
//
//===----------------------------------------------------------------------===//

#ifndef EXPR
#define EXPR(CLASS)
#endif
#ifndef STMT
#define STMT(CLASS)
#endif

// Expressions
EXPR(IntegerLiteral)  // 42
EXPR(StringLiteral)   // 'abc', 'c'
EXPR(NameRef)         // x, maxint, true                       (M4)
EXPR(Paren)           // ( e )                                 (M4)
EXPR(Unary)           // -e, +e, not e                         (M4)
EXPR(Binary)          // a + b, a div b, a < b, a and b, ...   (M4)
EXPR(Call)            // abs(x), ord(c)                        (M4)
EXPR(Formatted)       // e:width[:precision] in write/writeln  (M4)

// Statements
STMT(Empty)
STMT(Compound)
STMT(ProcCall)
STMT(Assign)          // x := e                                (M4)
STMT(If)              // if c then s [else s]                  (M5)
STMT(While)           // while c do s                          (M5)
STMT(Repeat)          // repeat s; s until c                   (M5)
STMT(For)             // for v := a to|downto b do s           (M5)
STMT(Case)            // case e of 1: s; 2, 3: s end           (M5)

#undef STMT
#undef EXPR
