; Project files (pcc.json): found in the input's directory or its parents
; (the current directory without an input file), named with --project,
; ignored with --no-project. Their settings are defaults the command line
; overrides; their paths are relative to their directory; without an input
; file pcc builds their main program (into their output, whose directory
; is created).
; RUN: rm -rf %t && mkdir -p %t && cp -R %S/Inputs/project %t/
; RUN: cd %t/project && %pcc-project 2>&1 | count 0
; RUN: %t/project/bin/app | FileCheck --check-prefix=OUT %s
; RUN: cd %t/project/src && %pcc-project app.pas -o %t/app2 2>&1 | count 0
; RUN: %t/app2 | FileCheck --check-prefix=OUT %s
; OUT: hello, project
; RUN: cd %t/project && %pcc-project --emit-ast | FileCheck --check-prefix=AST %s
; AST: ProgramDecl 'app'

; The command line wins: --mode=iso rejects the units the project's objfpc
; allows; -o replaces the project's output.
; RUN: cd %t/project && not %pcc-project --mode=iso 2>&1 | FileCheck --check-prefix=ISO %s
; ISO: src/app.pas:4:1: error: units are a Turbo/Free Pascal extension; use --mode=tp
; RUN: cd %t/project && %pcc-project -o %t/app3 && %t/app3 | FileCheck --check-prefix=OUT %s
; RUN: cd %t/project && not %pcc-project --no-project 2>&1 | FileCheck --check-prefix=NONE %s
; NONE: pcc: error: no input file

; Settings checked: types, values, duplicates; unknown names warn.
; RUN: not %pcc-project --project=%S/Inputs/project-files/settings.json -ferror-limit=0 %S/Inputs/project-files/hello.pas 2>&1 | FileCheck --check-prefix=SET %s
; SET: settings.json:11:3: error: duplicate setting 'main'
; SET: settings.json:2:11: error: 'mode' must be "iso", "tp" or "objfpc"
; SET: settings.json:3:15: error: 'optimize' must be an integer from 0 to 3
; SET: settings.json:4:12: error: 'debug' must be true or false
; SET: settings.json:5:16: error: 'unitPaths' must be an array of strings
; SET: settings.json:6:17: error: 'errorLimit' must be an integer (0: no limit)
; SET: settings.json:7:15: error: 'warnings' must be an object
; SET: settings.json:8:24: error: 'checks.range' must be true or false
; SET: settings.json:8:27: warning: unknown setting 'checks.ranges'; ignored
; SET: settings.json:9:3: warning: unknown setting 'colour'; ignored
; SET-NOT: hello.pas

; JSON syntax: the first error; strict JSON values otherwise accepted.
; RUN: not %pcc-project --project=%S/Inputs/project-files/syntax.json %S/Inputs/project-files/hello.pas 2>&1 | FileCheck --check-prefix=SYN %s
; SYN: syntax.json:3:19: error: expected ',' or ']'
; SYN-NOT: error:
; RUN: %pcc-project --project=%S/Inputs/project-files/values.json %S/Inputs/project-files/hello.pas -o %t/hello 2>&1 | FileCheck --check-prefix=VAL %s
; VAL: values.json:1:74: warning: unknown setting 'x'; ignored
; VAL-NOT: error:
; RUN: not %pcc-project --project=%t/nonexistent.json 2>&1 | FileCheck --check-prefix=OPEN %s
; OPEN: pcc: error: cannot open project file '{{.*}}nonexistent.json': No such file or directory
; RUN: cd %t && not %pcc-project --project=%S/Inputs/project-files/nomain.json 2>&1 | FileCheck --check-prefix=MAIN %s
; MAIN: pcc: error: no input file, and the project file '{{.*}}nomain.json' has no "main" program
