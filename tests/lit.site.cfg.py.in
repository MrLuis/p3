@LIT_SITE_CFG_IN_HEADER@

config.p3_src_root = "@PROJECT_SOURCE_DIR@"
config.p3_obj_root = "@PROJECT_BINARY_DIR@"
config.p3_tools_dir = "@PROJECT_BINARY_DIR@/bin"
config.llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"
config.filecheck = "@FILECHECK_EXECUTABLE@"
config.selfhost_flags = "@P3_SELFHOST_FLAGS@"
config.cmake = "@CMAKE_COMMAND@"
config.llvm_targets = "@P3_LLVM_TARGETS_LINKED@"

lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
