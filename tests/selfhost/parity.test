; S10: the self-hosted compiler writes the same LLVM IR as the C++ pcc,
; byte for byte, with and without -g: for the programs of the run tests,
; the compiler's own source, random programs from utils/gen-pascal.py, and
; programs with classes.
; (By hand, at scale: see selfhost/README.md.)
; REQUIRES: selfhost-build
; RUN: %pcc --mode=tp %selfhost-flags -I %S/../../selfhost %S/../../selfhost/pcc.pas -o %t.pcc
; RUN: rm -rf %t.gen && mkdir -p %t.gen/iso %t.gen/tp
; RUN: python3 %S/../../utils/gen-pascal.py --mode iso --count 15 --seed 5 --out %t.gen/iso
; RUN: python3 %S/../../utils/gen-pascal.py --mode tp --count 15 --seed 6 --out %t.gen/tp
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-o -" --ref pcc --new %t.pcc %S/../run %S/../codegen/Inputs | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-g -o -" --ref pcc --new %t.pcc %S/../run %S/../codegen/Inputs | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-o -" --modes=tp --ref pcc --new %t.pcc %S/../../selfhost/pcc.pas | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-g -o -" --modes=iso --ref pcc --new %t.pcc %t.gen/iso | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-g -o -" --modes=tp --ref pcc --new %t.pcc %t.gen/tp | FileCheck %s
; Classes (--mode=objfpc), with and without -g, and with units compiled
; whole and separately.
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-I %S/../run/Inputs/classes/lib -o -" --modes=objfpc --ref pcc --new %t.pcc %S/../run/classes.pas %S/../run/classes2.pas %S/../run/Inputs/classes %S/../codegen/Inputs/classes.pas | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-I %S/../run/Inputs/classes/lib -g -o -" --modes=objfpc --ref pcc --new %t.pcc %S/../run/classes.pas %S/../run/classes2.pas %S/../run/Inputs/classes %S/../codegen/Inputs/classes.pas | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-I %S/../run/Inputs/classes/lib -fseparate-units -g -o -" --modes=objfpc --ref pcc --new %t.pcc %S/../run/Inputs/classes | FileCheck %s
; Separate units (S11): the unit modules and the program importing them.
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-I %S/../run/Inputs/units/lib -o -" --modes=tp --ref pcc --new %t.pcc %S/../run/Inputs/units | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-llvm --extra="-I %S/../run/Inputs/units/lib -fseparate-units -g -o -" --modes=tp --ref pcc --new %t.pcc %S/../run/Inputs/units | FileCheck %s
; CHECK: runs, 0 differ
