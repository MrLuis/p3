; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-ast --extra="-o -" --modes=objfpc --ref pcc --new %t.pcc %S/../run/inlinevar.pas %S/../run/owned.pas | FileCheck %s
; RUN: python3 %S/../../utils/selfhost-diff.py --action=--emit-parse-tree --extra="-o -" --modes=objfpc --ref pcc --new %t.pcc %S/../run/inlinevar.pas %S/../run/owned.pas | FileCheck %s
