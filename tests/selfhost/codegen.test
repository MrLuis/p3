; S7: the self-hosted code generator. The Pascal compiler built by pcc must
; write IR that passes the verifier, compile run tests to programs with the
; expected output (%selfhost-cc lets clang assemble and link its IR), and
; compile itself to a stage 2 compiler that writes the same IR: the
; bootstrap fixed point. (By hand also: the whole run/ suite and
; iso7185pat.pas through utils/selfhost-cc.py, and identical IR from the
; pcc-built, FPC-built and stage 2 compilers; see selfhost/README.md.)
; REQUIRES: selfhost-clang
; RUN: %pcc --mode=tp -I %S/../../selfhost %S/../../selfhost/pcc.pas -o %t.pcc
;
; Programs, ISO and Turbo mode.
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc %S/../run/arith.pas -o %t.arith
; RUN: %t.arith > %t.arith.out && diff %S/../run/arith.expected %t.arith.out
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc %S/../run/routines.pas -o %t.routines
; RUN: %t.routines > %t.routines.out && diff %S/../run/routines.expected %t.routines.out
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc %S/../run/gotoproc.pas -o %t.gotoproc
; RUN: %t.gotoproc > %t.gotoproc.out && diff %S/../run/gotoproc.expected %t.gotoproc.out
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc %S/../run/ptrsets.pas -o %t.ptrsets
; RUN: %t.ptrsets > %t.ptrsets.out && diff %S/../run/ptrsets.expected %t.ptrsets.out
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc --mode=tp %S/../run/records.pas -o %t.records
; RUN: %t.records > %t.records.out && diff %S/../run/records.expected %t.records.out
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc --mode=tp %S/../run/tpa.pas -o %t.tpa
; RUN: %t.tpa > %t.tpa.out && diff %S/../run/tpa.expected %t.tpa.out
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc --mode=tp %S/../run/ints.pas -o %t.ints
; RUN: %t.ints > %t.ints.out && diff %S/../run/ints.expected %t.ints.out
;
; A runtime error.
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc %S/Inputs/rterr.pas -o %t.rterr
; RUN: not %t.rterr 2>&1 | FileCheck --check-prefix=RTERR %s
; RTERR: value out of range at {{.*}}rterr.pas:7:12
;
; The bootstrap fixed point.
; RUN: %t.pcc --mode=tp -I %S/../../selfhost %S/../../selfhost/pcc.pas --emit-llvm -o %t.stage2.ll
; RUN: env SELFHOST_PCC=%t.pcc %selfhost-cc --mode=tp -I %S/../../selfhost %S/../../selfhost/pcc.pas -o %t.stage2
; RUN: %t.stage2 --mode=tp -I %S/../../selfhost %S/../../selfhost/pcc.pas --emit-llvm -o %t.stage3.ll
; RUN: diff %t.stage2.ll %t.stage3.ll
