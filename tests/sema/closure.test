; Closures (objfpc): `reference to` procedural types, whose lambdas may
; outlive the routine they are made in. They may not use what does not live
; in that routine's frame (var, out, const and open parameters, the
; function's result, a record method's Self), nor its nested routines; a
; reference value and a plain procedural value do not convert into each
; other. A lambda cannot use a field through a with statement outside it.
; RUN: not %p3 --mode=objfpc -ferror-limit=0 -c %S/Inputs/closure/errors.pas -o %t.o 2>&1 | FileCheck %s
; CHECK: errors.pas:15:32: error: this closure uses 'a', through the Self of 'Get' (a record, passed by reference), which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:26:26: error: this closure uses 'v', a 'var' parameter of 'ByVar', which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:26:31: error: this closure uses 'o', an 'out' parameter of 'ByVar', which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:32:34: error: this closure uses 's', a 'const' parameter of 'ByConst', which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:32:37: error: this closure uses 'n', a 'constref' parameter of 'ByConst', which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:32:47: error: this closure uses 'items', an open or untyped parameter of 'ByConst', which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:39:21: error: this closure uses 'Total', the result of 'Total', which may not exist when the closure runs; copy it to a local variable first
; CHECK: errors.pas:51:28: error: this closure uses 'Helper', a routine nested in 'Nested'; a closure can only use routines declared at program or unit level
; CHECK: errors.pas:52:14: error: '@Helper': only routines declared at program or unit level can be procedural values
; CHECK: errors.pas:63:5: error: assigning to 'TFn' from incompatible type 'TPlain'
; CHECK: errors.pas:64:5: error: assigning to 'TPlain' from incompatible type 'TFn'
; CHECK: errors.pas:67:5: error: assigning to 'TFn' from incompatible type 'TPlain'
; CHECK: errors.pas:76:29: error: this lambda uses 'a' through a 'with' statement outside it; name the record instead
; CHECK-NOT: error:
;
; RUN: not %p3 --mode=objfpc -ferror-limit=0 -c %S/Inputs/closure/syntax.pas -o %t.o 2>&1 | FileCheck --check-prefix=SYNTAX %s
; SYNTAX: syntax.pas:3:31: error: a 'reference to' type cannot be 'of object'
; SYNTAX: syntax.pas:4:8: error: a 'reference to' type cannot have a calling convention
; SYNTAX: syntax.pas:5:21: error: expected 'procedure' or 'function' after 'reference to'
; SYNTAX-NOT: error:
;
; `reference` is not reserved: outside objfpc, and as a name, it is an
; identifier.
; RUN: not %p3 --mode=tp -c %S/Inputs/closure/tp.pas -o %t.o 2>&1 | FileCheck --check-prefix=TP %s
; TP: tp.pas:3:18: error: expected ';' after type declaration
;
; RUN: %p3 --mode=objfpc --emit-parse-tree %S/Inputs/closure/ast.pas -o - | FileCheck --check-prefix=PARSE %s
; PARSE: RoutineTypeSpec function reference <4:9>
;
; RUN: %p3 --mode=objfpc --emit-ast %S/Inputs/closure/ast.pas -o - | FileCheck --check-prefix=AST %s
; AST: TypeDecl 'tfn' = TFn <4:3>
; AST: NameRefExpr 'result' function result : TFn <11:3>
; AST-NEXT: AddrOfExpr : reference to function(integer): integer <11:13>
;
; The code: the frame of the routine the closure is made in is on the heap,
; reference counted; frame.fini releases what it holds when the last
; reference goes. Reference values are counted where they are stored.
; RUN: %p3 --mode=objfpc --emit-llvm %S/Inputs/closure/ast.pas -o %t.ll
; RUN: FileCheck --check-prefix=IR %s < %t.ll
; RUN: opt -passes=verify -disable-output %t.ll
; IR-LABEL: define i32 @main(
; IR: call void @__pas_closure_assign(ptr @pas.f, ptr %fn, ptr %frame)
; IR-LABEL: define internal { ptr, ptr } @pas.makeadder(i32 %n)
; IR: %frame = call ptr @__pas_frame_new(i64 32, ptr @frame.fini.makeadder)
; IR: insertvalue { ptr, ptr } { ptr @"pas.makeadder.$lambda1", ptr undef }, ptr %frame, 1
; IR: call void @__pas_closure_assign(
; IR: call void @__pas_frame_release(ptr %frame)
; IR-NEXT: ret { ptr, ptr }
; IR-LABEL: define internal i32 @"pas.makeadder.$lambda1"(ptr %link, i32 %x)
; IR: getelementptr inbounds nuw %frame.makeadder, ptr %link, i32 0, i32 0
; IR-LABEL: define internal void @frame.fini.makeadder(ptr %frame)
; IR-NEXT: entry:
; IR-NEXT: [[S:%[0-9]+]] = getelementptr inbounds nuw %frame.makeadder, ptr %frame, i32 0, i32 1
; IR-NEXT: call void @__pas_astr_clear(ptr [[S]])
; IR-NEXT: ret void
