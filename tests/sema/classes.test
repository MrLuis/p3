; Private members are visible in the unit declaring the class, protected
; ones also in methods of descendants.
; RUN: not %pcc --mode=objfpc -ferror-limit=0 -I %S/../run/Inputs/classes/lib -c %S/Inputs/classes/visibility.pas -o %t.o 2>&1 | FileCheck --check-prefix=VIS %s
