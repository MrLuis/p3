program c;
var i, j: integer; ch: char; b: boolean;
begin
  if i then writeln;
  while ch do writeln;
  repeat until 1;
  for maxint := 1 to 2 do writeln;
  for ch := 1 to 2 do writeln;
  for i := 1 to 'z' do writeln;
  for i := 1 to 10 do begin
    i := 5;
    read(i);
    for i := 1 to 2 do writeln
  end;
  for k := 1 to 2 do writeln;
  case i of
    1: writeln;
    'a': writeln;
    2, 1: writeln;
    j: writeln;
    -3, +4, maxint: writeln
  end;
  case b of
    true: writeln;
    false: writeln
  end
end.
