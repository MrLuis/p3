; Untyped parameters (Turbo/FPC  var x;  const x): only typecasts, @x, and
; untyped parameters (also move and fillchar's) can use them; arguments must
; be variables; typecasts of const ones are read-only. Not in ISO Pascal.
; RUN: not %p3 --mode=tp -ferror-limit=0 -c %S/Inputs/untyped/errors.pas -o %t.o 2>&1 | FileCheck %s
; CHECK: errors.pas:4:11: error: 'x' is an untyped parameter: use a typecast such as longint(x), its address, or pass it to an untyped parameter
; CHECK: errors.pas:8:3: error: cannot assign to untyped parameter 'x'; assign to a typecast such as longint(x)
; CHECK: errors.pas:13:8: error: 'x' is an untyped parameter
; CHECK: errors.pas:17:3: error: cannot modify constant parameter 'x'
; CHECK: errors.pas:15:27: note: 'x' declared here
; CHECK: errors.pas:21:18: error: 'x' is an untyped parameter
; CHECK: errors.pas:29:9: error: cannot modify constant parameter 'x'
; CHECK: errors.pas:30:12: error: cannot modify constant parameter 'x'
; CHECK: errors.pas:37:9: error: 'x' is an untyped parameter
; CHECK: errors.pas:42:9: error: argument for untyped parameter 'x' must be a variable
; CHECK: errors.pas:43:9: error: argument for untyped parameter 'x' must be a variable
; CHECK: errors.pas:44:13: error: argument for untyped parameter 'x' must be a variable
; CHECK-NOT: error:

; RUN: not %p3 --mode=iso -c %S/Inputs/untyped/iso.pas -o %t.o 2>&1 | FileCheck --check-prefix=ISO %s
; ISO: iso.pas:2:18: error: expected ':' after parameter name

; The dumps, and what the code passes: addresses.
; RUN: %p3 --mode=objfpc --emit-ast %S/../run/untyped.pas | FileCheck --check-prefix=AST %s
; AST: ParamDecl const 'a' : untyped
; AST: ParamDecl var 'x' : untyped
; RUN: %p3 --mode=objfpc --emit-parse-tree %S/../run/untyped.pas | FileCheck --check-prefix=TREE %s
; TREE:      ParamDecl const 'data' <22:27>
; TREE-NEXT:   UntypedTypeSpec <22:27>
; RUN: %p3 --mode=objfpc --emit-llvm %S/../run/untyped.pas -o - | FileCheck --check-prefix=IR %s
; IR: declare i32 @memcmp(ptr nocapture readonly, ptr nocapture readonly, i64)
; IR: call void @pas.setlong(ptr null, ptr @pas.i, i32 42)
; IR: define internal void @pas.setlong(ptr %link, ptr nonnull %x, i32 %v)
