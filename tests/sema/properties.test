; Properties and visibility (--mode=objfpc): accessors of array and indexed
; properties, the default property, strict private and strict protected.
; RUN: not %p3 --mode=objfpc -ferror-limit=0 -c %S/Inputs/properties/errors.pas -o %t.o 2>&1 | FileCheck %s
