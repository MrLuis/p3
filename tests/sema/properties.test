; CHECK: errors.pas:47:10: error: 'FS' is a strict private member of 'TA'
; CHECK: errors.pas:5:5: note: 'FS' declared here
; CHECK: errors.pas:48:10: error: 'FP' is a strict protected member of 'TA'
; CHECK: errors.pas:11:5: note: 'FP' declared here
; CHECK: errors.pas:49:10: error: array property 'P' needs an index
; CHECK: errors.pas:13:14: note: 'P' declared here
; CHECK: errors.pas:50:5: error: array property 'P' needs an index
; CHECK: errors.pas:13:14: note: 'P' declared here
; CHECK: errors.pas:51:12: error: cannot pass a value of type 'char' to parameter 'i' of type 'integer'
; CHECK: errors.pas:52:5: error: property 'RO' is read-only
; CHECK: errors.pas:23:14: note: 'RO' declared here
; CHECK: errors.pas:53:8: error: argument for 'var' parameter 'x' must be a variable
; CHECK: errors.pas:54:8: error: argument for 'var' parameter 'x' must be a variable
