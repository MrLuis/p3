; Generic methods in advanced records (objfpc): an implementation needs the
; record's declaration; each declared one is implemented; class ones must be
; static.
; RUN: not %p3 --mode=objfpc -ferror-limit=0 -c %S/Inputs/recordgenerics/errors.pas -o %t.o 2>&1 | FileCheck %s
; CHECK: errors.pas:16:23: error: record 'TRec' has no generic method 'Other' with 1 type parameter
; CHECK: errors.pas:7:22: error: method 'TRec.Never' is declared but never implemented
; CHECK-NOT: error:
; RUN: not %p3 --mode=objfpc -c %S/Inputs/recordgenerics/static.pas -o %t.o 2>&1 | FileCheck --check-prefix=STATIC %s
; STATIC: static.pas:5:28: error: the class methods of a record must be 'static'
