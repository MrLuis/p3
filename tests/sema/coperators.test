; Free Pascal's C operators: x += e is checked as x := x + (e), so the
; operator and the assignment report what they would (once for a bad
; target, whose second reading is not checked). A property cannot be the
; target (Free Pascal rejects it too), nor a function outside its body.
; {$coperators off} turns them off (then `+=` is `+` and `=`); they are
; off in ISO mode unless {$coperators on}.
; RUN: not %p3 --mode=objfpc -ferror-limit=0 -c %S/Inputs/coperators/errors.pas -o %t.o 2>&1 | FileCheck %s
; CHECK: errors.pas:17:3: error: cannot assign to untyped parameter 'u'; assign to a typecast such as longint(u)
; CHECK-NOT: errors.pas:17:
; CHECK: errors.pas:24:3: error: use of undeclared identifier 'undeclared'
; CHECK-NOT: errors.pas:24:
; CHECK: errors.pas:25:3: error: cannot assign to function 'g' outside its body
; CHECK-NOT: errors.pas:25:
; CHECK: errors.pas:26:8: error: use of undeclared identifier 'undeclared2'
; CHECK: errors.pas:27:5: error: assigning to 'integer' from incompatible type 'real'
; CHECK: errors.pas:28:5: error: assigning to 'char' from incompatible type 'string'
; CHECK: errors.pas:29:5: error: invalid operands to '+' ('boolean' and 'boolean')
; CHECK: errors.pas:30:5: error: invalid operands to '-' ('string' and 'char')
; CHECK: errors.pas:31:7: error: '+=' cannot assign to a property; use ':='
; CHECK-NOT: errors.pas:32
; RUN: not %p3 --mode=tp -c %S/Inputs/coperators/off.pas -o %t.o 2>&1 | FileCheck --check-prefix=OFF %s
; OFF-NOT: off.pas:5
; OFF: off.pas:7:5: error:
; RUN: not %p3 --mode=iso -c %S/Inputs/coperators/iso.pas -o %t.o 2>&1 | FileCheck --check-prefix=ISO %s
; ISO: iso.pas:6:5: error:
; RUN: %p3 --mode=iso %S/Inputs/coperators/isoon.pas -o %t.isoon
; RUN: %t.isoon | FileCheck --check-prefix=ISOON %s
; ISOON: 2
; RUN: not %p3 --mode=tp -c %S/Inputs/coperators/directive.pas -o %t.o 2>&1 | FileCheck --check-prefix=DIR %s
; DIR: directive.pas:1:1: error: expected {$coperators on} or {$coperators off}
