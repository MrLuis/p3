; Type helpers of a unit's interface, used by the program (methods, a
; static class method, an inline method), compiled whole and separately.
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/typehelpers/. %t/
; RUN: %p3 --mode=objfpc -I %t/lib %t/main.pas -o %t/whole
; RUN: %t/whole | FileCheck %s
; RUN: %p3 --mode=objfpc -c %t/lib/hstr.pas -o %t/lib/hstr.o
; RUN: %p3 --mode=objfpc -I %t/lib -fseparate-units %t/main.pas -o %t/separate
; RUN: %t/separate | FileCheck %s
; CHECK:      heyhey! *** xy!
; CHECK-NEXT: 49
