; {$pointermath checked}: runtime bounds checking for pointer arithmetic,
; indexing, Inc/Dec, and pointer difference (at -O0 and -O2).
; RUN: %p3 --mode=tp -O0 %S/Inputs/pointermath_checked.pas -o %t.o0
; RUN: %t.o0 ok | FileCheck --check-prefix=OK %s
; RUN: %p3 --mode=tp -O2 %S/Inputs/pointermath_checked.pas -o %t.o2
; RUN: %t.o2 ok | FileCheck --check-prefix=OK %s
; OK: 10 30 40 2
; OK-NEXT: 4
; OK-NEXT: 40
; OK-NEXT: 60 6
; OK-NEXT: 99

; Out-of-bounds, nil, different-allocation, stack, and freed pointer traps:
; RUN: not %t.o0 oob-idx 2>&1 | FileCheck --check-prefix=IDX %s
; RUN: not %t.o0 neg-idx 2>&1 | FileCheck --check-prefix=IDX %s
; RUN: not %t.o0 stack 2>&1 | FileCheck --check-prefix=IDX %s
; RUN: not %t.o0 nil-idx 2>&1 | FileCheck --check-prefix=IDX %s
; RUN: not %t.o0 freed 2>&1 | FileCheck --check-prefix=IDX %s
; RUN: not %t.o2 freed 2>&1 | FileCheck --check-prefix=IDX %s
; IDX: Runtime error: pointer index out of bounds

; RUN: not %t.o0 oob-add 2>&1 | FileCheck --check-prefix=ADD %s
; RUN: not %t.o0 oob-inc 2>&1 | FileCheck --check-prefix=ADD %s
; ADD: Runtime error: pointer arithmetic out of bounds

; RUN: not %t.o0 diff 2>&1 | FileCheck --check-prefix=DIFF %s
; DIFF: Runtime error: pointer difference requires pointers in the same live allocation
