; A generic type helper of a unit (for every dynamic array, with a generic
; method), used by a program: compiled whole and separately.
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/generichelpers/. %t/
; RUN: %pcc --mode=objfpc -I %t/lib %t/main.pas -o %t/whole
; RUN: %t/whole | FileCheck %s
; RUN: %pcc --mode=objfpc -c %t/lib/arrays.pas -o %t/lib/arrays.o
; RUN: %pcc --mode=objfpc -I %t/lib -fseparate-units %t/main.pas -o %t/separate
; RUN: %t/separate | FileCheck %s
; CHECK: 2 #3 #4 2
