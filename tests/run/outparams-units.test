; Out parameters in a unit's interface, compiled whole and separately.
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/outparams/. %t/
; RUN: %p3 --mode=objfpc -I %t/lib %t/main.pas -o %t/whole
; RUN: %t/whole | FileCheck %s
; RUN: %p3 --mode=objfpc -c %t/lib/getter.pas -o %t/lib/getter.o
; RUN: %p3 --mode=objfpc -I %t/lib -fseparate-units %t/main.pas -o %t/separate
; RUN: %t/separate | FileCheck %s
; CHECK:      filled 6
; CHECK-NEXT: method
