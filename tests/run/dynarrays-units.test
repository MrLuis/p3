; Dynamic arrays across units, compiled whole and separately.
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/dynarrays/. %t/
; RUN: %pcc --mode=objfpc -I %t/lib %t/main.pas -o %t/whole
; RUN: %t/whole | FileCheck %s
; RUN: %pcc --mode=objfpc -c %t/lib/store.pas -o %t/lib/store.o
; RUN: %pcc --mode=objfpc -I %t/lib -fseparate-units %t/main.pas -o %t/separate
; RUN: %t/separate | FileCheck %s
; CHECK:      2 item unit
; CHECK-NEXT: 2 y
; CHECK-NEXT: changed
