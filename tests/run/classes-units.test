; Classes in units (--mode=objfpc): a class declared in a unit's interface,
; implemented in its implementation part and extended by the program,
; compiled whole and separately. A separately compiled unit exports the
; class's VMT as pas.<unit>$<class>$vmt and its methods as
; pas.<unit>$<class>.<method>.
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/classes/. %t/
; RUN: %p3 --mode=objfpc -I %t/lib %t/zoo.pas -o %t/whole
; RUN: %t/whole | FileCheck %s
; RUN: %p3 --mode=objfpc -c %t/lib/animals.pas -o %t/lib/animals.o
; RUN: %p3 --mode=objfpc -I %t/lib -fseparate-units %t/zoo.pas -o %t/separate
; RUN: %t/separate | FileCheck %s
; CHECK:      dog says woof (...)
; CHECK-NEXT: <a dogs>
; CHECK-NEXT: dog 5 TDog
; CHECK-NEXT: dog says woof (...)
; CHECK-NEXT: cat says ...
; CHECK-NEXT: the cat 2
; CHECK-NEXT: bye dog
; CHECK-NEXT: 55
; CHECK-NEXT: list freed
;
; RUN: %p3 --mode=objfpc --emit-llvm %t/lib/animals.pas -o - | FileCheck --check-prefix=UNIT %s
; UNIT-DAG: @"pas.animals$tanimal$vmt" = constant [7 x ptr] [ptr @__pas_tobject_vmt, ptr @.str, ptr inttoptr (i64 {{[0-9]+}} to ptr), ptr null, ptr @__pas_tobject_destroy, ptr @"pas.animals$tanimal.sound", ptr @"pas.animals$tanimal.describe"]
; UNIT-DAG: define void @"pas.animals$tanimal.create"(ptr %link, ptr %self, ptr nonnull dereferenceable(256) %aname, i32 %alegs)
; UNIT-DAG: define void @"pas.animals$tanimal.speak"(ptr %link, ptr %self)
; RUN: %p3 --mode=objfpc -I %t/lib -fseparate-units --emit-llvm %t/zoo.pas -o - | FileCheck --check-prefix=PROG %s
; PROG-DAG: @"pas.animals$tanimal$vmt" = external constant [7 x ptr]
; PROG-DAG: @vmt.tdog = internal constant [7 x ptr] [ptr @"pas.animals$tanimal$vmt", ptr @.str, ptr inttoptr (i64 {{[0-9]+}} to ptr), ptr null, ptr @pas.tdog.destroy, ptr @pas.tdog.sound, ptr @pas.tdog.describe]
; PROG-DAG: declare void @"pas.animals$tanimal.speak"(ptr, ptr)
