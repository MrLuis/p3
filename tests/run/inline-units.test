; Separately compiled units leave their IR next to the object at -O1+; a
; program built with -fseparate-units links it before optimizing and
; inlines the unit's inline routines (item 17).
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/inlineunits/. %t/
; RUN: %p3 --mode=objfpc -I %t/lib -O2 -c %t/lib/mathx.pas -o %t/lib/mathx.o
; RUN: test -f %t/lib/mathx.ll
; (-fno-internalize-runtime: __pas_write_int stays a call, whose argument
; shows the inlined Twice folded to 42.)
; RUN: %p3 --mode=objfpc -I %t/lib -fseparate-units -O2 -fno-internalize-runtime --emit-llvm %t/main.pas -o - | FileCheck %s
; RUN: env P3_RUNTIME_LIB=%p3-runtime-lib %p3 --mode=objfpc -I %t/lib -fseparate-units -O2 %t/main.pas -o %t/main
; RUN: %t/main | FileCheck --check-prefix=OUT %s

; CHECK-NOT: call i32 @"pas.mathx$twice"
; CHECK: call void @__pas_write_int(ptr {{.*}}, i64 42, i32 0)
; OUT: 42
