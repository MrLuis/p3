; Overloading in units (--mode=objfpc), compiled whole and separately:
; overloaded routines and methods are exported as pas.<unit>$<name>$N.
; RUN: rm -rf %t && mkdir -p %t && cp -r %S/Inputs/overloads/. %t/
; RUN: %p3 --mode=objfpc -I %t/lib %t/main.pas -o %t/whole
; RUN: %t/whole | FileCheck %s
; RUN: %p3 --mode=objfpc -c %t/lib/fmt.pas -o %t/lib/fmt.o
; RUN: %p3 --mode=objfpc -I %t/lib -fseparate-units %t/main.pas -o %t/separate
; RUN: %t/separate | FileCheck %s
; CHECK: #6 "abab"
; RUN: %p3 --mode=objfpc --emit-llvm %t/lib/fmt.pas -o - | FileCheck --check-prefix=UNIT %s
; UNIT-DAG: define i32 @"pas.fmt$twice$1"(ptr %link, i32 %x)
; UNIT-DAG: define void @"pas.fmt$twice$2"(ptr %link, ptr nonnull dereferenceable(256) %result.ptr, ptr nonnull dereferenceable(256) %s)
; UNIT-DAG: define void @"pas.fmt$tformatter.show$1"(ptr %link, ptr %self, ptr nonnull dereferenceable(256) %result.ptr, i32 %x)
