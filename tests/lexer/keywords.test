; All reserved words (PLAN.md 4.2/4.3, and objfpc's), mixed case.
; RUN: %p3 --emit-tokens %S/Inputs/keywords.pas | FileCheck --check-prefixes=CHECK,ISO,NOOBJ %s
; RUN: %p3 --emit-tokens --mode=tp %S/Inputs/keywords.pas | FileCheck --check-prefixes=CHECK,TP,NOOBJ %s
; RUN: %p3 --emit-tokens --mode=objfpc %S/Inputs/keywords.pas | FileCheck --check-prefixes=CHECK,TP,OBJ %s

; CHECK: 1:1 kw_and 'AND'
; CHECK-NEXT: 1:{{[0-9]+}} kw_array 'Array'
; CHECK-NEXT: 1:{{[0-9]+}} kw_begin 'begin'
; CHECK-NEXT: 1:{{[0-9]+}} kw_case 'CASE'
; CHECK-NEXT: 1:{{[0-9]+}} kw_const 'Const'
; CHECK-NEXT: 1:{{[0-9]+}} kw_div 'div'
; CHECK-NEXT: 1:{{[0-9]+}} kw_do 'DO'
; CHECK-NEXT: 1:{{[0-9]+}} kw_downto 'Downto'
; CHECK-NEXT: 1:{{[0-9]+}} kw_else 'else'
; CHECK-NEXT: 1:{{[0-9]+}} kw_end 'END'
; CHECK-NEXT: 1:{{[0-9]+}} kw_file 'File'
; CHECK-NEXT: 1:{{[0-9]+}} kw_for 'for'
; CHECK-NEXT: 1:{{[0-9]+}} kw_function 'FUNCTION'
; CHECK-NEXT: 1:{{[0-9]+}} kw_goto 'Goto'
; CHECK-NEXT: 1:{{[0-9]+}} kw_if 'if'
; CHECK-NEXT: 1:{{[0-9]+}} kw_in 'IN'
; CHECK-NEXT: 1:{{[0-9]+}} kw_label 'Label'
; CHECK-NEXT: 1:{{[0-9]+}} kw_mod 'mod'
; CHECK-NEXT: 1:{{[0-9]+}} kw_nil 'NIL'
; CHECK-NEXT: 1:{{[0-9]+}} kw_not 'Not'
; CHECK-NEXT: 1:{{[0-9]+}} kw_of 'of'
; CHECK-NEXT: 1:{{[0-9]+}} kw_or 'OR'
; CHECK-NEXT: 1:{{[0-9]+}} kw_packed 'Packed'
; CHECK-NEXT: 1:{{[0-9]+}} kw_procedure 'procedure'
; CHECK-NEXT: 1:{{[0-9]+}} kw_program 'PROGRAM'
; CHECK-NEXT: 1:{{[0-9]+}} kw_record 'Record'
; CHECK-NEXT: 1:{{[0-9]+}} kw_repeat 'repeat'
; CHECK-NEXT: 1:{{[0-9]+}} kw_set 'SET'
; CHECK-NEXT: 1:{{[0-9]+}} kw_then 'Then'
; CHECK-NEXT: 1:{{[0-9]+}} kw_to 'to'
; CHECK-NEXT: 1:{{[0-9]+}} kw_type 'TYPE'
; CHECK-NEXT: 1:{{[0-9]+}} kw_until 'Until'
; CHECK-NEXT: 1:{{[0-9]+}} kw_var 'var'
; CHECK-NEXT: 1:{{[0-9]+}} kw_while 'WHILE'
; CHECK-NEXT: 1:{{[0-9]+}} kw_with 'With'
; ISO-NEXT: 2:1 identifier 'unit' name=unit
; ISO-NEXT: 2:{{[0-9]+}} identifier 'interface' name=interface
; ISO-NEXT: 2:{{[0-9]+}} identifier 'implementation' name=implementation
; ISO-NEXT: 2:{{[0-9]+}} identifier 'uses' name=uses
; ISO-NEXT: 2:{{[0-9]+}} identifier 'initialization' name=initialization
; ISO-NEXT: 2:{{[0-9]+}} identifier 'finalization' name=finalization
; ISO-NEXT: 2:{{[0-9]+}} identifier 'string' name=string
; ISO-NEXT: 2:{{[0-9]+}} identifier 'shl' name=shl
; ISO-NEXT: 2:{{[0-9]+}} identifier 'shr' name=shr
; ISO-NEXT: 2:{{[0-9]+}} identifier 'xor' name=xor
; ISO-NEXT: 2:{{[0-9]+}} identifier 'inline' name=inline
; ISO-NEXT: 2:{{[0-9]+}} identifier 'asm' name=asm
; ISO-NEXT: 2:{{[0-9]+}} identifier 'object' name=object
; ISO-NEXT: 2:{{[0-9]+}} identifier 'constructor' name=constructor
; ISO-NEXT: 2:{{[0-9]+}} identifier 'destructor' name=destructor
; TP-NEXT: 2:1 kw_unit 'unit'
; TP-NEXT: 2:{{[0-9]+}} kw_interface 'interface'
; TP-NEXT: 2:{{[0-9]+}} kw_implementation 'implementation'
; TP-NEXT: 2:{{[0-9]+}} kw_uses 'uses'
; TP-NEXT: 2:{{[0-9]+}} kw_initialization 'initialization'
; TP-NEXT: 2:{{[0-9]+}} kw_finalization 'finalization'
; TP-NEXT: 2:{{[0-9]+}} kw_string 'string'
; TP-NEXT: 2:{{[0-9]+}} kw_shl 'shl'
; TP-NEXT: 2:{{[0-9]+}} kw_shr 'shr'
; TP-NEXT: 2:{{[0-9]+}} kw_xor 'xor'
; TP-NEXT: 2:{{[0-9]+}} kw_inline 'inline'
; TP-NEXT: 2:{{[0-9]+}} kw_asm 'asm'
; TP-NEXT: 2:{{[0-9]+}} kw_object 'object'
; TP-NEXT: 2:{{[0-9]+}} kw_constructor 'constructor'
; TP-NEXT: 2:{{[0-9]+}} kw_destructor 'destructor'
; NOOBJ-NEXT: 3:1 identifier 'class' name=class
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'Inherited' name=inherited
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'IS' name=is
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'as' name=as
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'property' name=property
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'Try' name=try
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'except' name=except
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'FINALLY' name=finally
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'raise' name=raise
; NOOBJ-NEXT: 3:{{[0-9]+}} identifier 'on' name=on
; OBJ-NEXT: 3:1 kw_class 'class'
; OBJ-NEXT: 3:{{[0-9]+}} kw_inherited 'Inherited'
; OBJ-NEXT: 3:{{[0-9]+}} kw_is 'IS'
; OBJ-NEXT: 3:{{[0-9]+}} kw_as 'as'
; OBJ-NEXT: 3:{{[0-9]+}} kw_property 'property'
; OBJ-NEXT: 3:{{[0-9]+}} kw_try 'Try'
; OBJ-NEXT: 3:{{[0-9]+}} kw_except 'except'
; OBJ-NEXT: 3:{{[0-9]+}} kw_finally 'FINALLY'
; OBJ-NEXT: 3:{{[0-9]+}} kw_raise 'raise'
; `on` (exception handlers) is not reserved.
; OBJ-NEXT: 3:{{[0-9]+}} identifier 'on' name=on
; CHECK-NEXT: 4:1 identifier 'break' name=break
; CHECK-NEXT: 4:{{[0-9]+}} identifier 'continue' name=continue
; CHECK-NEXT: 4:{{[0-9]+}} identifier 'exit' name=exit
; CHECK-NEXT: 4:{{[0-9]+}} identifier 'forward' name=forward
; CHECK-NEXT: 4:{{[0-9]+}} identifier 'otherwise' name=otherwise
; CHECK-NEXT: 4:{{[0-9]+}} identifier 'integer' name=integer
; CHECK-NEXT: 4:{{[0-9]+}} identifier 'writeln' name=writeln
; CHECK-NEXT: eof
