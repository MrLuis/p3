; Every operator / punctuator (PLAN.md 4.4).
; RUN: %pcc --emit-tokens %S/Inputs/punctuation.pas | FileCheck --check-prefixes=CHECK,ISO %s
; RUN: %pcc --emit-tokens --mode=tp %S/Inputs/punctuation.pas | FileCheck --check-prefixes=CHECK,TP %s

; CHECK:      1:1 plus '+'
; CHECK-NEXT: 1:3 minus '-'
; CHECK-NEXT: 1:5 star '*'
; CHECK-NEXT: 1:7 slash '/'
; CHECK-NEXT: 1:9 equal '='
; CHECK-NEXT: 1:11 not_equal '<>'
; CHECK-NEXT: 1:14 less '<'
; CHECK-NEXT: 1:16 less_equal '<='
; CHECK-NEXT: 1:19 greater '>'
; CHECK-NEXT: 1:21 greater_equal '>='
; CHECK-NEXT: 1:24 colon_equal ':='
; CHECK-NEXT: 1:27 colon ':'
; CHECK-NEXT: 1:29 semi ';'
; CHECK-NEXT: 1:31 comma ','
; CHECK-NEXT: 1:33 period '.'
; CHECK-NEXT: 1:35 dotdot '..'
; CHECK-NEXT: 1:38 l_paren '('
; CHECK-NEXT: 1:40 r_paren ')'
; CHECK-NEXT: 1:42 l_square '['
; CHECK-NEXT: 1:44 r_square ']'
; CHECK-NEXT: 1:46 caret '^'
; CHECK-NEXT: 1:48 l_square '(.'
; CHECK-NEXT: 1:51 r_square '.)'
; ISO-NEXT:   1:54 caret '@'
; TP-NEXT:    1:54 at '@'
; Maximal munch:
; CHECK-NEXT: 2:1 less '<'
; CHECK-NEXT: 2:2 not_equal '<>'
; CHECK-NEXT: 2:4 greater_equal '>='
; CHECK-NEXT: 2:7 identifier 'a'
; CHECK-NEXT: 2:8 colon_equal ':='
; CHECK-NEXT: 2:10 identifier 'b'
; CHECK-NEXT: 2:12 identifier 'a'
; CHECK-NEXT: 2:13 period '.'
; CHECK-NEXT: 2:14 identifier 'b'
; CHECK-NEXT: 2:16 dotdot '..'
; CHECK-NEXT: 2:18 r_paren ')'
; CHECK-NEXT: eof
