; Template strings (tp, objfpc): text between backticks. Without an
; interpolation, and raw (r`...`), one is a string_literal; with them it is
; a template_head, the tokens of each value, template_middles and a
; template_tail. A token's value has the escapes resolved; the layout's
; indentation is removed by the lexer from a whole string, and by the parser
; from the parts.
; RUN: %p3 --mode=tp --emit-tokens %S/Inputs/templates.pas | FileCheck %s
; RUN: %p3 --mode=objfpc --emit-tokens %S/Inputs/templates.pas | FileCheck %s

; CHECK:      1:1 string_literal '`plain`' value="plain"
; CHECK-NEXT: 1:9 string_literal '`a``b`' value="a`b"
; CHECK-NEXT: 1:16 string_literal '`$${x} $ $$`' value="${x} $ $$"
; CHECK-NEXT: 1:29 string_literal '``' value=""
; CHECK-NEXT: 1:32 string_literal '`c`' value="c"
; CHECK-NEXT: 2:1 string_literal 'r`raw ${x} \n`' value="raw ${x} \\n"
; CHECK-NEXT: 2:16 string_literal 'R`up`' value="up"
; CHECK-NEXT: 3:1 template_head '`a ${' value="a "
; CHECK-NEXT: 3:6 identifier 'x' name=x
; CHECK-NEXT: 3:7 template_middle '} b ${' value=" b "
; CHECK-NEXT: 3:14 identifier 'y' name=y
; CHECK-NEXT: 3:15 colon ':'
; CHECK-NEXT: 3:16 integer_literal '2' value=2
; CHECK-NEXT: 3:18 template_tail '} c`' value=" c"
; CHECK-NEXT: 4:1 template_head '`${' value=""
; CHECK-NEXT: 4:4 identifier 'x' name=x
; CHECK-NEXT: 4:5 template_middle '}${' value=""
; CHECK-NEXT: 4:8 identifier 'y' name=y
; CHECK-NEXT: 4:9 template_tail '}`' value=""
; A template inside a value, a '}' in a string and a comment there.
; CHECK-NEXT: 5:1 template_head '`out ${' value="out "
; CHECK-NEXT: 5:9 template_head '`in ${' value="in "
; CHECK-NEXT: 5:15 identifier 'z' name=z
; CHECK-NEXT: 5:16 template_tail '} ner`' value=" ner"
; CHECK-NEXT: 5:23 plus '+'
; CHECK-NEXT: 5:25 string_literal ''}'' value="}"
; CHECK-NEXT: 5:33 template_tail '} er`' value=" er"
; Lines.
; CHECK-NEXT: 6:1 string_literal '`
; CHECK-NEXT:     one
; CHECK-NEXT:       two
; CHECK-NEXT:     `' value="one\n  two"
; CHECK-NEXT: 10:1 template_head '`first ${' value="first "
; CHECK-NEXT: 10:10 identifier 'x' name=x
; CHECK-NEXT: 10:11 template_middle '}
; CHECK-NEXT:     second
; CHECK-NEXT:     ${' value="\n    second\n    "
; CHECK-NEXT: 12:7 identifier 'y' name=y
; CHECK-NEXT: 12:8 template_tail '} third
; CHECK-NEXT:   `' value=" third\n  "
; Text that is not compiled is skipped; r is a name unless a backtick
; follows it at once.
; CHECK-NEXT: 14:34 identifier 'rx' name=rx
; CHECK-NEXT: 14:37 identifier 'r' name=r
; CHECK-NEXT: 14:39 string_literal '`spaced`' value="spaced"
; CHECK-NEXT: 15:1 eof ''

; A line end is one \n in the value, whatever the source has; a template
; must end.
; RUN: printf 'a `x\r\n  y\rz` `open ${b} never closed\n' > %t.pas
; RUN: not %p3 --mode=tp --emit-tokens %t.pas 2>&1 | FileCheck --check-prefix=ENDS %s
; (The bare CR inside line 2 ends the source line a diagnostic shows, but
; columns count from the last \n: llvm::SourceMgr's accounting since
; LLVM 22, unlike LLVM 19's.)
; ENDS: 2:17: error: unterminated template string
; ENDS: 1:3 string_literal '`x
; ENDS: value="x\n  y\nz"
; ENDS: 2:8 template_head '`open ${' value="open "
; ENDS: 2:17 template_tail '} never closed
; ENDS: ' value=" never closed\n"

; ISO mode has no template strings.
; RUN: not %p3 --emit-tokens %S/Inputs/templates.pas 2>&1 | FileCheck --check-prefix=ISO %s
; ISO: templates.pas:1:1: error: invalid character '`' in source
