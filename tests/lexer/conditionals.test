; Conditional compilation in the lexer: the predefined symbols (P3 and one
; for the mode), -d, skipped text (only comments, strings and conditional
; directives are recognized in it), conditionals around and in include
; files, and the errors.
; RUN: %p3 --emit-tokens %S/Inputs/cond/modes.pas | FileCheck --check-prefix=ISO %s
; ISO:      1:13 identifier 'a'
; ISO-NEXT: 2:17 identifier 'iso'
; ISO-NEXT: 6:44 identifier 'nocmdline'
; ISO-NEXT: 9:44 identifier 'z'
; ISO-NEXT: eof
; RUN: %p3 --mode=tp -dCmdLine --emit-tokens %S/Inputs/cond/modes.pas | FileCheck --check-prefix=TP %s
; TP:      1:13 identifier 'a'
; TP-NEXT: 3:16 identifier 'tp'
; TP-NEXT: 5:18 identifier 'cmdline'
; TP-NEXT: 9:44 identifier 'z'
; TP-NEXT: eof
; RUN: %p3 --mode=objfpc -d cmdline -d Other --emit-tokens %S/Inputs/cond/modes.pas | FileCheck --check-prefix=OBJ %s
; OBJ:      1:13 identifier 'a'
; OBJ-NEXT: 4:20 identifier 'objfpc'
; OBJ-NEXT: 5:18 identifier 'cmdline'
; OBJ-NEXT: 9:44 identifier 'z'

; An include file shares the including file's symbols; a conditional must
; end in the file that starts it, and an include directive in a skipped
; branch is not followed.
; RUN: not %p3 --mode=tp --emit-tokens %S/Inputs/cond/include.pas 2>&1 | FileCheck --check-prefix=INC %s
; INC:      cond.inc:3:1: error: $ENDIF without a matching $IF or $IFDEF
; INC:      cond.inc:4:1: error: $IFDEF is not terminated; expected $ENDIF before the end of the file
; INC:      2:15 identifier 'i'
; INC:      10:21 identifier 'a'
; INC-NEXT: 11:17 identifier 'b'
; INC-NOT:  error
; INC:      eof

; RUN: not %p3 --mode=tp -ferror-limit=0 --emit-tokens %S/Inputs/cond/errors.pas 2>&1 >/dev/null | FileCheck --check-prefix=ERR %s
; ERR:      errors.pas:2:1: error: $ELSE without a matching $IF or $IFDEF
; ERR-NEXT: {$else}
; ERR-NEXT: ^
; ERR-NEXT: errors.pas:3:1: error: 'foo' has no value in $IF (a macro needs {$macro on} and {$define foo := value})
; ERR:      errors.pas:5:1: error: invalid $IF expression (expected values, macros, defined(NAME), comparisons, + - * div mod, not, and, or)
; ERR:      errors.pas:7:1: error: expected a symbol name after $DEFINE
; ERR:      errors.pas:8:1: warning: macro support is off: 'x' is defined without a value (use {$macro on})
; ERR:      errors.pas:9:1: error: $IFOPT is not supported
; ERR:      errors.pas:12:1: error: $ELSE after $ELSE
; ERR:      errors.pas:13:1: error: $ELSEIF after $ELSE
; ERR:      errors.pas:16:1: error: $ELSEIF cannot continue $IFNDEF; use $ELSE
; ERR:      errors.pas:25:1: error: $IFDEF is not terminated; expected $ENDIF before the end of the file
; ERR-NOT:  error:
