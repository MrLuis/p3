; Constructs of later milestones get a clear "not supported yet", and the
; parser recovers after each one.
; RUN: not %pcc --emit-ast %S/Inputs/unsupported.pas 2>&1 >/dev/null | FileCheck --check-prefix=UNSUP %s
; UNSUP: unsupported.pas:2:1: error: 'var' declarations are not supported yet
