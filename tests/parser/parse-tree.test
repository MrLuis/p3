; --emit-parse-tree: the parser's output without Sema, with type specs,
; typed-constant values, uses clauses and units (SELFHOST.md S5).
; RUN: not %p3 --mode=tp --emit-parse-tree %S/Inputs/parse-tree.pas 2>%t.err | FileCheck %s
; RUN: FileCheck --check-prefix=ERR %s < %t.err

; CHECK:      ProgramDecl 'pt' <1:1>
; CHECK-NEXT:   Uses 'shapes' <2:6>
; CHECK-NEXT:   TypeDecl 'tkind' <4:3>
