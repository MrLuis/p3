; Output kinds: -c, -S, --emit-llvm, executables, default names, cross targets.
; RUN: rm -rf %t.dir && mkdir -p %t.dir

; RUN: %p3 -c %S/../driver/Inputs/hello.pas -o %t.dir/hello.o
; RUN: llvm-nm %t.dir/hello.o | FileCheck --check-prefix=OBJ %s
; Mach-O (macOS) prefixes C symbols with '_'.
; OBJ-DAG: T {{_?}}main
; OBJ-DAG: U {{_?}}__pas_init
; OBJ-DAG: U {{_?}}__pas_write_str

; RUN: %p3 -S %S/../driver/Inputs/hello.pas -o %t.dir/hello.s
; RUN: FileCheck --check-prefix=ASM %s < %t.dir/hello.s
; ASM: main:

; Default output names are derived from the input file.
; RUN: cd %t.dir && %p3 -c %S/../driver/Inputs/hello.pas && %p3 -S %S/../driver/Inputs/hello.pas
; RUN: cd %t.dir && %p3 --emit-llvm %S/../driver/Inputs/hello.pas && %p3 %S/../driver/Inputs/hello.pas
; RUN: cd %t.dir && ls hello.o hello.s hello.ll hello
; RUN: %t.dir/hello | FileCheck --check-prefix=EXEC %s
; RUN: FileCheck --check-prefix=IR %s < %t.dir/hello.ll
; EXEC: Hello, World!
; IR: define i32 @main(

; Cross compilation to objects works for any LLVM target...
; RUN: %p3 -c --target=riscv64-unknown-linux-gnu %S/../driver/Inputs/hello.pas -o %t.dir/rv.o
; RUN: llvm-readobj --file-headers %t.dir/rv.o | FileCheck --check-prefix=RV %s
; RV: Machine: EM_RISCV
; M11: object files for the main object formats (the input uses setjmp-based
; non-local goto, files and procedural parameters).
; RUN: %p3 -c -O2 --target=x86_64-unknown-linux-gnu %S/../run/gotoproc.pas -o %t.dir/x86.o
; RUN: llvm-readobj --file-headers %t.dir/x86.o | FileCheck --check-prefix=ELF %s
; ELF: Format: elf64-x86-64
; RUN: %p3 -c -O2 --target=aarch64-apple-darwin %S/../run/gotoproc.pas -o %t.dir/macho.o
; RUN: llvm-readobj --file-headers %t.dir/macho.o | FileCheck --check-prefix=MACHO %s
; MACHO: Format: Mach-O arm64
; RUN: %p3 -c -O2 --target=x86_64-pc-windows-msvc %S/../run/gotoproc.pas -o %t.dir/coff.o
; RUN: llvm-readobj --file-headers %t.dir/coff.o | FileCheck --check-prefix=COFF %s
; COFF: Format: COFF-x86-64
; RUN: %p3 -c -O2 --target=wasm32-unknown-wasi %S/../run/gotoproc.pas -o %t.dir/wasm.o
; RUN: llvm-readobj --file-headers %t.dir/wasm.o | FileCheck --check-prefix=WASM %s
; WASM: Format: WASM

; ...but linking an executable for another target needs the runtime built
; for it (P3_CROSS_TARGETS; tests/driver/windows-link.test).
; RUN: not %p3 --target=riscv64-unknown-linux-gnu %S/../driver/Inputs/hello.pas -o %t.dir/rv 2>&1 | FileCheck --check-prefix=XLINK %s
; XLINK: error: no Pascal runtime for target 'riscv64-unknown-linux-gnu' (configure p3 with -DP3_CROSS_TARGETS=riscv64-unknown-linux-gnu); -c, -S and --emit-llvm work without it


; Missing runtime library is reported clearly.
; RUN: env P3_RUNTIME_LIB=%t.dir/nope.a not %p3 %S/../driver/Inputs/hello.pas -o %t.dir/x 2>&1 | FileCheck --check-prefix=NORT %s
; NORT: error: cannot find the Pascal runtime library '{{.*}}nope.a'; set P3_RUNTIME_LIB
