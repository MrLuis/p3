; Short strings (--mode=tp) in calls: a function writes its result through
; a pointer to a temporary of the caller (its result variable is that
; temporary); a value parameter gets the caller's string and copies the
; characters in use into its own variable; a const parameter reads the
; caller's. s := s + x appends in place.
; RUN: %p3 --mode=tp --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck %s

; CHECK-LABEL: define i32 @main(
; CHECK:      %result = alloca [256 x i8]
; a := a + 'y'
; CHECK:      call void @__pas_str_append(ptr @pas.a, i32 255, ptr @.str{{.*}})
; CHECK:      call void @pas.shout(ptr noalias sret([256 x i8]) %result, ptr @pas.a, ptr @.str{{.*}})
; CHECK-NEXT: call void @__pas_str_assign(ptr @pas.b, i32 8, ptr %result)

; CHECK-LABEL: define internal void @pas.shout(ptr noalias nonnull sret([256 x i8]) dereferenceable(256) %result.ptr, ptr %s, ptr nonnull dereferenceable(256) %t)
; CHECK:      %s.addr = alloca [256 x i8]
; CHECK:      store ptr %result.ptr, ptr %shout
; The result starts empty.
; CHECK:      %shout.ref = load ptr, ptr %shout
; CHECK:      call void @__pas_str_assign(ptr %s.addr, i32 255, ptr %s)
; CHECK:      store ptr %t, ptr %t.addr
; CHECK:      call void @__pas_str_append(ptr %s.addr, i32 255, ptr
; The concatenation temporary lives only for this statement (item 5).
; CHECK:      call void @llvm.lifetime.start.p0(i64 256, ptr %[[STR:str[0-9]*]])
; CHECK:      call void @__pas_str_concat(ptr %[[STR]], ptr %s.addr, ptr %t.ref)
; CHECK:      call void @llvm.lifetime.end.p0(i64 256, ptr %[[STR]])
; CHECK:      ret void
