; Only locals written inside a protected region and read after the landing
; stay in the frame; read-only and overwritten locals are allocas (item 3).
; RUN: %p3 --mode=objfpc --emit-llvm %S/Inputs/pins.pas -o - | FileCheck %s

; CHECK: %frame.f = type { i32, i32 }
; CHECK-LABEL: define internal i32 @pas.f(
; CHECK: %frame = alloca %frame.f
; CHECK: store volatile ptr %frame, ptr %pin
; CHECK: %n.addr = alloca i32
; CHECK: %ro = alloca i32
; CHECK: %dead = alloca i32
; CHECK: %before = alloca i32
; live and the result are written in the try and read in the handler.
; CHECK: %live = getelementptr inbounds nuw %frame.f, ptr %frame, i32 0, i32 0
; CHECK: %f = getelementptr inbounds nuw %frame.f, ptr %frame, i32 0, i32 1
