; M6 lowering: each routine keeps params and locals in a frame struct; a
; nested routine gets its parent's frame as a hidden first argument (static
; link, frame field 0) and reaches the parent's variables through it.
; RUN: %pcc --emit-llvm %S/Inputs/nested.pas -o - | FileCheck %s

; CHECK-DAG: %frame.outer = type { i32, i32 }
; CHECK-DAG: %frame.outer.inner = type { ptr }
; CHECK-DAG: @pas.g = internal global i32 0

; CHECK: define internal void @pas.outer(i32 %p)
; CHECK:   %frame = alloca %frame.outer
; CHECK:   [[P:%.*]] = getelementptr inbounds %frame.outer, ptr %frame, i32 0, i32 0
; CHECK:   store i32 %p, ptr [[P]]
; CHECK:   call void @pas.outer.inner(ptr %frame)

; CHECK: define internal void @pas.outer.inner(ptr %link)
; CHECK:   %frame = alloca %frame.outer.inner
; CHECK:   store ptr %link, ptr
; Up-level access: load the static link, then index the parent's frame.
; CHECK:   [[L1:%.*]] = load ptr, ptr {{%.*}}
; CHECK:   getelementptr inbounds %frame.outer, ptr [[L1]], i32 0, i32 0
; CHECK:   load i32, ptr @pas.g
; CHECK:   getelementptr inbounds %frame.outer, ptr {{%.*}}, i32 0, i32 1

; At -O2 the frames disappear.
; RUN: %pcc --emit-llvm -O2 %S/Inputs/nested.pas -o - | FileCheck --check-prefix=O2 %s
; O2: define {{.*}}i32 @main(
; O2-NOT: alloca
