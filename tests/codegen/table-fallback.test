; Unsupported table shapes fall back to setjmp under -ftable-exceptions
; (optimization2 item 8b6): re-raise, handler-raise, and nested try.
; RUN: %p3 --mode=objfpc --ftable-exceptions -fkeep-unused --emit-llvm %S/Inputs/table-fallback.pas -o - | FileCheck %s

; CHECK-LABEL: define internal void @pas.reraise(
; CHECK: call i32 @_setjmp(
; CHECK-NOT: personality ptr @__pas_personality
; CHECK-LABEL: define internal void @pas.handlerraise(
; CHECK: call i32 @_setjmp(
; CHECK-NOT: personality ptr @__pas_personality
; CHECK-LABEL: define internal void @pas.nested(
; CHECK: call i32 @_setjmp(
; CHECK-NOT: personality ptr @__pas_personality
