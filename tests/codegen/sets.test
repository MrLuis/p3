; Sets (optimization.md, item 6). A set is an integer whose bit i is member
; i: i32 when the element type's highest value is at most 31, i64 when at
; most 63, else i256. Operations on sets of different sizes are done in the
; larger one. x in [...] is tested without building the set.
; RUN: %pcc --mode=tp -fno-range-checks --emit-llvm %S/Inputs/sets.pas -o %t.ll
; RUN: FileCheck %s < %t.ll
; RUN: opt -passes=verify -disable-output %t.ll

; CHECK: @pas.colors = internal global i32 0
; CHECK: @pas.mid = internal global i64 0
; CHECK: @pas.chars = internal global i256 0

; sizeof: 4, 8 and 32 bytes.
; CHECK-LABEL: define i32 @main(
; CHECK: call void @__pas_write_int(ptr %file, i64 4, i32 0)
; CHECK: call void @__pas_write_int(ptr %file, i64 8, i32 0)
; CHECK: call void @__pas_write_int(ptr %file, i64 32, i32 0)

; k in colors: within the 32 bits, and that bit.
; CHECK-LABEL: define internal void @pas.member(
; CHECK:      %colors = load i32, ptr @pas.colors
; CHECK-NEXT: %[[OK:[0-9]+]] = icmp ule i64 %[[X:[0-9]+]], 31
; CHECK-NEXT: %[[M:[0-9]+]] = and i64 %[[X]], 31
; CHECK-NEXT: %[[I:[0-9]+]] = trunc i64 %[[M]] to i32
; CHECK-NEXT: %[[S:[0-9]+]] = lshr i32 %colors, %[[I]]
; CHECK-NEXT: %[[B:[0-9]+]] = trunc i32 %[[S]] to i1
; CHECK-NEXT: %in = and i1 %[[OK]], %[[B]]

; CHECK-LABEL: define internal void @pas.midmember(
; CHECK:      icmp ule i64 %{{[0-9]+}}, 63
; CHECK:      lshr i64 %mid,

; CHECK-LABEL: define internal void @pas.widemember(
; CHECK:      icmp ule i64 %{{[0-9]+}}, 255
; CHECK:      lshr i256 %chars,

; A set of an enumeration and a constructor of its values: all in i32. A
; constructor of integers is a set of integer (i256): the i64 operand is
; widened and the result narrowed (LLVM removes both from -O1).
; CHECK-LABEL: define internal void @pas.ops(
; CHECK:      shl i32 1,
; CHECK:      %union = or i32 %colors,
; CHECK:      zext i64 %mid to i256
; CHECK:      %intersection = and i256
; CHECK:      trunc i256 %intersection to i64
; CHECK:      %difference = and i256 %chars,
; CHECK:      %subset = icmp eq i32

; x in [one value]: a comparison.
; CHECK-LABEL: define internal void @pas.inone(
; CHECK:      %in = icmp eq i64 %{{[0-9]+}}, 120
; CHECK-NOT:  i256

; x in [one range]: two comparisons.
; CHECK-LABEL: define internal void @pas.inrange(
; CHECK:      %[[LO:[0-9]+]] = icmp sge i64 %[[X:[0-9]+]], 48
; CHECK-NEXT: %[[HI:[0-9]+]] = icmp sle i64 %[[X]], 57
; CHECK-NEXT: %in = and i1 %[[LO]], %[[HI]]
; CHECK-NOT:  i256

; Members at most 63 apart ('A'..'z'): a bit of a 64-bit mask.
; CHECK-LABEL: define internal void @pas.inmask(
; CHECK:      %[[D:[0-9]+]] = sub i64 %{{[0-9]+}}, 65
; CHECK-NEXT: %[[OK:[0-9]+]] = icmp ule i64 %[[D]], 57
; CHECK-NEXT: %[[M:[0-9]+]] = and i64 %[[D]], 63
; CHECK-NEXT: %[[S:[0-9]+]] = lshr i64 288230372997595135, %[[M]]
; CHECK-NEXT: %[[B:[0-9]+]] = trunc i64 %[[S]] to i1
; CHECK-NEXT: %in = and i1 %[[OK]], %[[B]]
; CHECK-NOT:  i256

; Further apart ('0'..'z'), up to four ranges: comparisons.
; CHECK-LABEL: define internal void @pas.inranges(
; CHECK:      icmp sge i64 %{{[0-9]+}}, 48
; CHECK:      icmp sle i64 %{{[0-9]+}}, 57
; CHECK:      icmp sge i64 %{{[0-9]+}}, 97
; CHECK:      icmp sle i64 %{{[0-9]+}}, 122
; CHECK:      or i1 %in, %in1
; CHECK-NOT:  i256

; An element that is not a constant: a comparison with its value.
; CHECK-LABEL: define internal void @pas.invar(
; CHECK:      %in = icmp eq i64 %{{[0-9]+}}, %{{[0-9]+}}
; CHECK:      icmp eq i64 %{{[0-9]+}}, 5
; CHECK-NOT:  i256
