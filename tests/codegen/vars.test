; M4 lowering: globals, boolean storage as i8, signed vs unsigned compares,
; runtime-checked div.
; RUN: %p3 --emit-llvm %S/Inputs/vars.pas -o - | FileCheck %s
; CHECK-DAG: @pas.x = internal global i32 0
; CHECK-DAG: @pas.b = internal global i8 0
; CHECK-DAG: @pas.c = internal global i8 0
; CHECK-DAG: @.rterr = private unnamed_addr constant {{.*}} c"division by zero\00"
; CHECK-DAG: @.file = private unnamed_addr constant {{.*}} c"{{.*}}vars.pas\00"
; CHECK-DAG: @.loc = private constant {{.*}} { ptr @.file, i32 8, i32 10 }
; CHECK: declare void @__pas_runtime_error_at(ptr, ptr) #[[ATTR:[0-9]+]]
; CHECK: define i32 @main(
; CHECK:   store i32 1, ptr @pas.x
; CHECK:   [[X:%.*]] = load i32, ptr @pas.x
; CHECK:   [[CMP:%.*]] = icmp slt i32 [[X]], 2
; CHECK:   [[B:%.*]] = zext i1 [[CMP]] to i8
; CHECK:   store i8 [[B]], ptr @pas.b
; CHECK:   icmp ugt i8 {{%.*}}, 97
; A constant non-zero divisor needs no checks:
; CHECK-NOT: rt.error
; CHECK:   sdiv i32 {{%.*}}, 3
; A variable divisor is checked:
; CHECK:   icmp eq i32 {{%.*}}, 0
; CHECK:   br i1 {{%.*}}, label %rt.error, label %rt.ok, !prof
; CHECK: rt.error:
; CHECK:   call void @__pas_runtime_error_at(ptr @.rterr, ptr @.loc)
; CHECK-NEXT: unreachable
; CHECK:   sdiv i32 {{%.*}}, {{%x[0-9]+}}
; CHECK: attributes #[[ATTR]] = { cold noreturn nounwind }
