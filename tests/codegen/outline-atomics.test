; On AArch64 Linux every function p3 defines gets "+outline-atomics" (clang's
; default there), so that reference counts use LSE where the CPU has it, in
; the program and in the inlined runtime. An -mattr that says anything about
; LSE is left alone. Other targets are not changed.
; RUN: %p3 --mode=tp --target=aarch64-unknown-linux-gnu --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck --check-prefix=LINUX %s
; LINUX: "target-cpu"="generic" "target-features"="+outline-atomics"
; RUN: %p3 --mode=tp --target=aarch64-unknown-linux-gnu -mattr=+crc --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck --check-prefix=APPEND %s
; APPEND: "target-features"="+crc,+outline-atomics"
; RUN: %p3 --mode=tp --target=aarch64-unknown-linux-gnu -mattr=+lse --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck --check-prefix=LSE %s
; LSE: "target-features"="+lse"
; LSE-NOT: outline-atomics
; RUN: %p3 --mode=tp --target=aarch64-unknown-linux-gnu -mattr=-outline-atomics --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck --check-prefix=OFF %s
; OFF: "target-features"="-outline-atomics"
; RUN: %p3 --mode=tp --target=aarch64-apple-darwin --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck --check-prefix=DARWIN %s
; DARWIN-NOT: outline-atomics
; RUN: %p3 --mode=tp --target=x86_64-unknown-linux-gnu --emit-llvm %S/Inputs/strpass.pas -o - | FileCheck --check-prefix=X86 %s
; X86-NOT: outline-atomics
