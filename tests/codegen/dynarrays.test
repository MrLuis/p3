; A dynamic array is a pointer to its elements. Each array type has a constant
; PasDynInfo: the element size and, for managed elements, functions that
; release and count one element.
; RUN: %pcc --mode=objfpc --emit-llvm %S/Inputs/dynarrays.pas -o - | FileCheck %s
; CHECK-DAG: @pas.a = internal global ptr null
; CHECK-DAG: @dyninfo = internal constant { i64, ptr, ptr } { i64 4, ptr null, ptr null }
; CHECK-DAG: @dyninfo.{{[0-9]+}} = internal constant { i64, ptr, ptr } { i64 8, ptr @dyn.fini, ptr @dyn.addref }
; CHECK-LABEL: define i32 @main(
; CHECK:     call void @__pas_dyn_setlength(ptr @pas.a, ptr @dyninfo, i64 2)
; Indexing is checked against the length.
; CHECK:     call i32 @__pas_dyn_bad_index(ptr %{{.*}}, i64 1)
; setlength of an array of arrays: the inner ones in a loop.
; CHECK:     call void @__pas_dyn_setlength(ptr @pas.m, ptr @dyninfo.{{[0-9]+}}, i64 2)
; CHECK:     dim.loop:
; CHECK:     call void @__pas_dyn_setlength(ptr %{{.*}}, ptr @dyninfo, i64 3)
; CHECK:     call void @__pas_dyn_assign(ptr @pas.a, ptr null)
; CHECK-LABEL: define internal void @dyn.fini(ptr %elem)
; CHECK:     call void @__pas_astr_clear(ptr %elem)
; CHECK-LABEL: define internal void @dyn.addref(ptr %elem)
; CHECK:     call void @__pas_astr_addref(
